# Production ortam değişkenleri — ÖRNEK dosya.
#
# Gerçek değerlerle doldurup `.env.production` olarak kaydedin.
# `.env.production` .gitignore altındadır — ASLA commit etmeyin.
# Bu dosyada (`.env.production.example`) yalnız değişken İSİMLERİ, güvenli
# açıklamalar ve SAHTE placeholder değerler bulunur — gerçek secret YOKTUR.
#
# `compose.production.yml` zorunlu değişkenler için `${VAR:?...}` sözdizimi
# kullanır — eksik bırakırsanız `docker compose config`/`up` AÇIK bir hatayla
# başarısız olur (sessizce güvensiz varsayılana düşmez).

# ─── Domain / TLS (Caddy) ────────────────────────────────────────────────
# Gerçek production domain'iniz. Caddy bunun için otomatik HTTPS sertifikası alır.
DOMAIN=panel.example.com
# Let's Encrypt sertifika/iptal bildirimleri için gerçek bir e-posta.
ACME_EMAIL=ops@example.com

# ─── Uygulama URL'leri ───────────────────────────────────────────────────
# Tarayıcının gördüğü public URL'ler (https, gerçek domain).
APP_URL=https://panel.example.com
# NOT: `/api` SUFFIX'İ EKLEMEYİN — hem backend'in kendi `API_URL` varsayılanı
# (`app/config.py`) hem frontend client'ı (`apps/web/lib/api/client.ts`)
# origin'i (şema+host, path YOK) bekler; her istek path'i zaten `/api/...`
# ile başlar. Suffix eklenirse Caddy'den geçen tüm frontend istekleri
# `/api/api/...`'a döner ve backend'e hiç ulaşmaz (bkz. CODEX_AUDIT_PHASE_6.md
# KRİTİK-1 — bu oturumda ampirik olarak doğrulanıp düzeltildi).
API_URL=https://panel.example.com
APP_TIMEZONE=Europe/Istanbul
# CORS: yalnız gerçek frontend origin'i (virgülle birden fazla origin olabilir).
CORS_ORIGINS=https://panel.example.com
# TrustedHostMiddleware: Caddy'nin ilettiği Host header'ı için izin verilen domain(ler).
TRUSTED_HOSTS=panel.example.com

# ─── PostgreSQL ──────────────────────────────────────────────────────────
POSTGRES_USER=ivac_prod
# openssl rand -base64 32 ile üretin — ASLA bu örnekteki gibi bırakmayın.
POSTGRES_PASSWORD=REPLACE_ME_WITH_STRONG_RANDOM_VALUE
POSTGRES_DB=ivac
POSTGRES_MEMORY_LIMIT=1g

# ─── Redis ───────────────────────────────────────────────────────────────
REDIS_PASSWORD=REPLACE_ME_WITH_STRONG_RANDOM_VALUE
REDIS_MAXMEMORY=256mb
REDIS_MEMORY_LIMIT=320m

# ─── Güvenlik anahtarları (her biri: openssl rand -base64 32) ────────────
JWT_SECRET=REPLACE_ME
COOKIE_SECRET=REPLACE_ME
PII_ENCRYPTION_KEY=REPLACE_ME
PHONE_HASH_PEPPER=REPLACE_ME
# Voice-agent -> backend dahili servis kimliği (en az 32 karakter, production'da
# "dev-insecure-" ile başlayamaz — app/config.py bunu doğrular).
INTERNAL_SERVICE_TOKEN=REPLACE_ME
# Rotasyon sırasında eski token'ı burada tutup kademeli geçiş yapabilirsiniz;
# rotasyon yoksa boş bırakın.
INTERNAL_SERVICE_TOKEN_PREVIOUS=

# ─── İlk yönetici (yalnız `make prod-bootstrap-admin` ile bir KEZ kullanılır) ─
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_ME_WITH_STRONG_PASSWORD

# ─── LiveKit (cloud VEYA ayrı işletilen self-hosted — bu compose LiveKit'i
# BARINDIRMAZ, bkz. PRODUCTION_INFRA_REPORT.md §2 kapsam kararı) ──────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=REPLACE_ME
LIVEKIT_API_SECRET=REPLACE_ME
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=REPLACE_ME

# ─── Netgsm SIP trunk ────────────────────────────────────────────────────
NETGSM_SIP_HOST=sip.netgsm.com.tr
NETGSM_SIP_PORT=5060
NETGSM_SIP_USERNAME=REPLACE_ME
NETGSM_SIP_PASSWORD=REPLACE_ME
NETGSM_OUTBOUND_NUMBER=REPLACE_ME
NETGSM_TRANSPORT=udp

# ─── OpenAI Realtime ─────────────────────────────────────────────────────
OPENAI_API_KEY=REPLACE_ME
OPENAI_REALTIME_DEFAULT_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_DEFAULT_VOICE=marin

# ─── Google Places (opsiyonel) ───────────────────────────────────────────
ENABLE_GOOGLE_PLACES=false
GOOGLE_PLACES_API_KEY=

# ─── Arama güvenlik kapıları — GERÇEK arama yapmadan önce bilinçli olarak açın ─
LIVE_CALLS_ENABLED=false
CAMPAIGNS_ENABLED=false
TEST_PHONE_ALLOWLIST=
MAX_CONCURRENT_CALLS=1
MAX_DAILY_CALLS=10

# ─── Kayıt / saklama ──────────────────────────────────────────────────────
CALL_RECORDING_ENABLED=false
TRANSCRIPT_STORAGE_ENABLED=true
TRANSCRIPT_RETENTION_DAYS=30
AUDIO_RETENTION_DAYS=0
HUMAN_TRANSFER_ENABLED=false
HUMAN_TRANSFER_NUMBER=

# ─── Gözlemleme ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
SENTRY_DSN=

# ─── Oturum ──────────────────────────────────────────────────────────────
SESSION_IDLE_SECONDS=43200
SESSION_ABSOLUTE_SECONDS=604800

# ─── Kaynak limitleri (opsiyonel override) ───────────────────────────────
API_MEMORY_LIMIT=512m
WORKER_MEMORY_LIMIT=512m
WORKER_CONCURRENCY=2
BEAT_MEMORY_LIMIT=192m
VOICE_AGENT_MEMORY_LIMIT=512m
FRONTEND_MEMORY_LIMIT=256m

# ─── Backup (local) ──────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=14

# ─── Off-site backup (restic) — credential yoksa local-only backup devam
# eder AMA bu "felaket kurtarmaya hazır" SAYILMAZ (bkz. BACKUP_AND_RESTORE.md) ─
BACKUP_REMOTE_ENABLED=false
RESTIC_REPOSITORY=s3:https://s3.your-region.amazonaws.com/your-backup-bucket
RESTIC_PASSWORD=REPLACE_ME_WITH_STRONG_RANDOM_VALUE
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_DEFAULT_REGION=eu-central-1
RESTIC_RETENTION_DAILY=14
RESTIC_RETENTION_WEEKLY=8
RESTIC_RETENTION_MONTHLY=6
# Her `restic` çağrısı (backup/check/forget) için üst sınır — erişilemeyen/
# yanlış yapılandırılmış bir off-site hedef bu süre dolmadan SÜRESİZ
# bloke olmaz, normal bir başarısızlık gibi ele alınır (CODEX_REAUDIT_PHASE_6.md
# sırasında ampirik olarak keşfedildi). Yalnız pozitif tam sayı (1-3600
# saniye) kabul edilir — `0` KABUL EDİLMEZ (coreutils `timeout 0` zaman
# aşımını DEVRE DIŞI bırakır, hang korumasını sessizce kapatır; bkz.
# CODEX_FINAL_AUDIT_PHASE_6.md ORTA-1). Boş/whitespace-only bırakılırsa
# script güvenli varsayılana (300) düşer.
RESTIC_TIMEOUT_SECONDS=300
