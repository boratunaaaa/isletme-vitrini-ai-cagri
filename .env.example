# ─── Uygulama ────────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=isletme-vitrini-ai-cagri
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
APP_TIMEZONE=Europe/Istanbul
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1

# ─── Veri katmanı ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://ivac:ivac@localhost:5432/ivac
REDIS_URL=redis://localhost:6379/0
# Testler için ayrı veritabanı (integration testleri bunu kullanır)
DATABASE_URL_TEST=postgresql+psycopg://ivac:ivac@localhost:5432/ivac_test

# ─── Güvenlik anahtarları (openssl rand -base64 32 ile üret) ────────────────
JWT_SECRET=
COOKIE_SECRET=
PII_ENCRYPTION_KEY=
PHONE_HASH_PEPPER=
# Voice agent -> API dahili servis kimliği
INTERNAL_SERVICE_TOKEN=
INTERNAL_SERVICE_TOKEN_PREVIOUS=
INTERNAL_SERVICE_NAME=voice-agent
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ─── LiveKit (self-hosted) ───────────────────────────────────────────────────
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=

# ─── Netgsm SIP trunk ────────────────────────────────────────────────────────
NETGSM_SIP_HOST=sip.netgsm.com.tr
NETGSM_SIP_PORT=5060
NETGSM_SIP_USERNAME=
NETGSM_SIP_PASSWORD=
NETGSM_OUTBOUND_NUMBER=
NETGSM_TRANSPORT=udp
NETGSM_CODEC_PREFERENCES=PCMA,PCMU

# ─── OpenAI Realtime ─────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_REALTIME_DEFAULT_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_PREMIUM_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_DEFAULT_VOICE=marin
OPENAI_REALTIME_REASONING_EFFORT=low

# ─── Voice Agent Runtime ────────────────────────────────────────────────────
VOICE_AGENT_ENV=development
VOICE_AGENT_NAME=isletme-vitrini-voice-agent
LIVEKIT_AGENT_NAME=isletme-vitrini-outbound-agent
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=3
EVENT_QUEUE_MAX_SIZE=500
TRANSCRIPT_QUEUE_MAX_SIZE=250
USAGE_FLUSH_INTERVAL_SECONDS=5
GRACEFUL_SHUTDOWN_SECONDS=15

# ─── Konuşma motoru ──────────────────────────────────────────────────────────
DEFAULT_CONVERSATION_ENGINE=openai_realtime
ENABLE_OPENAI_REALTIME=true
ENABLE_LOCAL_PIPELINE=false

# ─── Google Places (opsiyonel) ───────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=
ENABLE_GOOGLE_PLACES=false

# ─── Arama güvenlik kapıları ─────────────────────────────────────────────────
LIVE_CALLS_ENABLED=false
CAMPAIGNS_ENABLED=false
# Virgülle ayrılmış E.164 listesi; development'ta yalnız bu numaralar aranabilir
TEST_PHONE_ALLOWLIST=
MAX_CONCURRENT_CALLS=1
MAX_DAILY_CALLS=10

# ─── Arama politikaları ──────────────────────────────────────────────────────
DEFAULT_CALL_START_HOUR=10
DEFAULT_CALL_END_HOUR=17
MAX_CALL_DURATION_SECONDS=300
DEFAULT_MAX_RETRY_COUNT=2
DEFAULT_RETRY_DELAY_MINUTES=120

# ─── Kayıt ve saklama ────────────────────────────────────────────────────────
CALL_RECORDING_ENABLED=false
TRANSCRIPT_STORAGE_ENABLED=true
TRANSCRIPT_RETENTION_DAYS=30
AUDIO_RETENTION_DAYS=0

# ─── İnsana aktarma ──────────────────────────────────────────────────────────
HUMAN_TRANSFER_ENABLED=false
HUMAN_TRANSFER_NUMBER=

# ─── Gözlemleme ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
SENTRY_DSN=
